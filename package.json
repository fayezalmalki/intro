{
  "name": "intro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "typecheck": "cf workers types && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:seed:sql": "tsx scripts/seed.ts graph && tsx scripts/seed.ts demo",
    "db:migrate:remote": "cf d1 migrations apply \"$D1_DATABASE_ID\" --dir drizzle",
    "db:seed:remote": "tsx scripts/seed.ts graph && cf d1 query \"$D1_DATABASE_ID\" --sql \"$(cat drizzle/seed/graph.sql)\"",
    "db:local": "tsx scripts/db-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@vinext/cloudflare": "^1.4.0",
    "better-auth": "^1.7.28",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "vinext": "^1.4.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.5",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.6",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "5.7.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
