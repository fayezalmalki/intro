# ── Database ──────────────────────────────────────────────────
# Neon Postgres. Required in production: the JSON store refuses to start
# without it, because a serverless filesystem loses writes between requests.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local development against plain Postgres instead of Neon's HTTP driver.
# Also the driver row-level security needs — see drizzle/policies/rls.sql.
# DATABASE_DRIVER=postgres-js

# ── Claude ────────────────────────────────────────────────────
# Intent extraction. Without it the app falls back to a deterministic
# keyword extractor and every screen still works.
# ANTHROPIC_API_KEY=

# ── Auth (milestone 2, not yet wired) ─────────────────────────
# AUTH_SECRET=            # openssl rand -hex 32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# SMTP_PASSWORD=          # magic link sender

# ── Payments (milestone 4, not yet wired) ─────────────────────
# One StreamPay account serves several apps, so every checkout must be
# tagged { product: 'intro' } and the webhook must ignore anything else.
# STREAMPAY_API_KEY=
# STREAMPAY_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "off" to disable the development-only account shortcuts locally.
# They are disabled unconditionally in production.
# INTRO_DEV_TOOLS=off
