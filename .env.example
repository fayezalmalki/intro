# ── Database ──────────────────────────────────────────────────
# Local development against scripts/pg-start.sh (PGlite over the Postgres wire
# protocol — nothing to install). Copy this file to .env.local as-is.
DATABASE_DRIVER=postgres-js
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Production: Neon, via the Vercel integration. Leave DATABASE_DRIVER unset so
# the neon-serverless driver is used — it supports transactions, which the
# credit ledger needs.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Migrations use the unpooled connection: pgbouncer can mangle DDL.
# DATABASE_URL_UNPOOLED=

# ── Claude ────────────────────────────────────────────────────
# Intent extraction. Without it the app falls back to a deterministic keyword
# extractor and every screen still works.
# ANTHROPIC_API_KEY=

# ── Auth ──────────────────────────────────────────────────────
# Required in any deployment: without AUTH_SECRET there is no session, and
# without ADMIN_EMAILS no account can ever become an admin, so nobody can grant
# a role or verify an account. /api/health fails on either.
# AUTH_SECRET=            # openssl rand -hex 32
# ADMIN_EMAILS=you@intro.sa,someone@intro.sa
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=

# ── Outbound mail — pool 1 only ───────────────────────────────
# Sign-in codes and mail to our own users. intro.sa is connected to Resend,
# which is where pool 1 is headed; this SMTP path (ImprovMX) is what the code
# speaks today and stays as the fallback. The any-alias credential can set MAIL
# FROM to any address on the domain, which is why it is the one to use.
#
# See docs/sending-domains.md — and note the hard rule there: intro.sa NEVER
# authenticates as a careers.sa alias. lib/mailer.ts refuses to.
#
# Intro requests to third parties (pool 2) do NOT go through this, and are
# deferred. A subdomain on the same Resend account is NOT the answer: Resend's
# AUP prohibits unsolicited mail, so it risks the account that carries pool 1.
# SMTP_USER=any-alias-1@intro.sa
# SMTP_PASSWORD=          # never commit a value
# SMTP_HOST=smtp.improvmx.com   # the default
# SMTP_PORT=587                 # STARTTLS. 465 is implicit TLS; both are tried.
# SMTP_SECURE=                  # only to override the port's own inference
# SMTP_FROM=Intro <noreply@intro.sa>   # must be on intro.sa or it is ignored

# ── Coresignal ────────────────────────────────────────────────
# Company and people data. Search endpoints are free and return id arrays;
# collect and enrich cost credits (10 / 20 / 20), so lib/coresignal.ts logs
# every call to api_call_log and never buys the same one twice.
# Server-side only — this key must never reach a browser bundle.
# CORESIGNAL_API_KEY=

# ── Payments ──────────────────────────────────────────────────
# One StreamPay account serves several apps, so every checkout is tagged
# { product: 'intro' } and the webhook ignores anything else — see
# lib/payments/checkout.ts.
#
# Both or neither: a half-configured StreamPay would create real checkouts
# whose webhooks could never be verified. With neither set, the app uses a
# clearly-marked test provider that posts a signed payload through the real
# webhook route — same signature check, same idempotency, same ledger.
# STREAMPAY_API_KEY=
# STREAMPAY_WEBHOOK_SECRET=

# ── The GTM flow ──────────────────────────────────────────────
# Hand-written example rows for the two paid steps, so the review screen can be
# walked with no Coresignal key. Development only — disabled unconditionally in
# production, and every row it writes is marked as an example in the UI.
# INTRO_GTM_FIXTURES=off
#
# Outbound sending. Off everywhere by default: pool 2 needs intros.intro.sa on
# SES and pool 3 needs a Google OAuth grant behind a CASA assessment, so there
# is nothing that could return a provider message id — and without one, nothing
# may be marked sent. See docs/sending-domains.md.
# INTRO_SENDING_ENABLED=on

# ── Design references (.mcp.json) ─────────────────────────────
# Refero MCP, for pulling UI references while designing. Same key as
# about-sa uses. Tooling only — the app never reads it.
# REFERO_API_KEY=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "off" to disable the development-only account shortcuts locally.
# They are disabled unconditionally in production.
# INTRO_DEV_TOOLS=off
